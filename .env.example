# Mock mode is the default and needs no secrets.
# mock = fully local placeholders; hybrid = ChatGPT-plan text; openai = API key for text.
PROVIDER_MODE=mock
# mock = local placeholder art (free); openai = separately billed API artwork.
IMAGE_PROVIDER_MODE=mock
API_PORT=4317
WEB_PORT=5173
DATA_DIR=./data

# Real OpenAI mode remains disabled until both values below are set.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-sol
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
ALLOW_PAID_PROVIDER_CALLS=false

# Upload and generation guardrails.
MAX_UPLOAD_MB=12
MAX_PAGES_PER_CHAPTER=24
MAX_JOB_SPEND_USD=0
