# Mock mode is the default and needs no secrets.
PROVIDER_MODE=mock
API_PORT=4317
WEB_PORT=5173
DATA_DIR=./data

# Real OpenAI mode remains disabled until both values below are set.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-astra
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
ALLOW_PAID_PROVIDER_CALLS=false

# Upload and generation guardrails.
MAX_UPLOAD_MB=12
MAX_PAGES_PER_CHAPTER=24
MAX_JOB_SPEND_USD=0
